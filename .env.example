# ÉVORA OVERSIGHT — variáveis de ambiente para rodar via docker-compose.
# Copie para `.env` (mesma pasta do docker-compose.yml) e preencha com valores
# reais. NUNCA commite o `.env` de verdade — ele já está no .gitignore.

# --- usadas pelo serviço "motor-execucao" (ao-SUPABASE-BLOCO1) ---
#
# PARA TESTAR LOCAL (`supabase start`, ver supabase/config.toml): use
#   SUPABASE_URL=http://host.docker.internal:54321
# NÃO use http://127.0.0.1:54321 aqui — dentro do container do docker-compose,
# 127.0.0.1 é o próprio container, não o host. host.docker.internal é o jeito
# do Docker Desktop (Windows/Mac) apontar de volta pro host.
# A SUPABASE_SERVICE_ROLE_KEY local (fixa, não é segredo de verdade) sai no
# print do `supabase start`/`supabase status`, campo "service_role key".
#
# PARA O SUPABASE DE VERDADE (nuvem): Painel -> Project Settings -> API -> Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Painel do Supabase -> Project Settings -> API -> service_role key (secret)
# NUNCA a chave "anon"/"public" — esta ignora o RLS inteiro.
SUPABASE_SERVICE_ROLE_KEY=
# uuid do tenant e mundo (gabinete|campanha) — exigidos por falha fechada
TENANT_ID=
MUNDO=gabinete
# Opcional — default já é claude-opus-5
ANTHROPIC_MODEL_BRIEFING=claude-opus-5

# --- usada por ambos os serviços ("motor" e "motor-execucao") ---
# console.anthropic.com -> API Keys -> Create Key
ANTHROPIC_API_KEY=
