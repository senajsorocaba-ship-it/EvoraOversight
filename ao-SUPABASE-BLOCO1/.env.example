# ÉVORA OVERSIGHT — variáveis de ambiente do motor de execução do briefing
# (evora_motor_execucao.py). Copie para `.env` (ou exporte no ambiente do
# servidor) e preencha com valores reais. NUNCA commite o `.env` de verdade.
#
# Este arquivo é só documentação de quais variáveis existem — não contém
# nenhum segredo real.

# Painel do Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Painel do Supabase → Project Settings → API → service_role key (secret)
# NUNCA a chave "anon"/"public". NUNCA exponha esta chave a navegador/app
# mobile/frontend — ela ignora o RLS inteiro (ver evora_rls_mvp_v1.sql).
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=

# Opcional — default já é claude-opus-5 (ver evora_motor_execucao.py)
# ANTHROPIC_MODEL_BRIEFING=claude-opus-5
